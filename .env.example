# Copy this file to .env and fill in values.
# Generate KAFKA_CLUSTER_ID:    python -c "import base64,uuid; print(base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip('='))"
# Generate AIRFLOW_FERNET_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate AIRFLOW_SECRET_KEY:  python -c "import secrets; print(secrets.token_hex(32))"

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=olist-bronze
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Kafka KRaft ──────────────────────────────────────────────────────────────
KAFKA_CLUSTER_ID=<generate>
KAFKA_BROKER_PORT=9092

# ── Airflow 3.0 ──────────────────────────────────────────────────────────────
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_FERNET_KEY=<generate>
AIRFLOW_SECRET_KEY=<generate>
AIRFLOW_UID=50000

# ── Snowflake ────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
